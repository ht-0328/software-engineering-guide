# このリポジトリでの codex の実行方針（execpolicy）
#
# 形式は Starlark である。codex はリポジトリの根の .codex/rules/*.rules を読む。
# 使える関数は2つで、引数は次のとおりである。
#
#   prefix_rule(pattern=[...], decision="allow" | "prompt" | "forbidden")
#   network_rule(host="...", protocol="...", decision="allow" | "prompt" | "forbidden")
#
# 判定の順序は、実測で次のとおりだった（codex 0.149.1、Linux）。
#   - どの規則にも当たらないコマンドは、そのまま実行される。
#   - forbidden は、より具体的な allow より優先される。
#     そのため `git` 全体を allow して `git push` だけを forbidden にはできない。
#     許すものを個別に挙げる形にしている。
#
# 破ろうとすると、次の形で拒否される。
#   Rejected("... rejected: policy forbids commands starting with `ls`")

# --- 止めるもの ---------------------------------------------------------
#
# codex にはこのリポジトリの調査だけを頼む。書き込みと公開は依頼した側が行う。
# 読み取りのみのサンドボックスでも書き込みは失敗するが、
# 設定を変えて動かしたときに備えて、ここでも止めておく。

# 消す・動かす
prefix_rule(pattern=["rm"], decision="forbidden")
prefix_rule(pattern=["rmdir"], decision="forbidden")
prefix_rule(pattern=["mv"], decision="forbidden")
prefix_rule(pattern=["shred"], decision="forbidden")
prefix_rule(pattern=["truncate"], decision="forbidden")
prefix_rule(pattern=["chmod"], decision="forbidden")
prefix_rule(pattern=["chown"], decision="forbidden")

# 履歴と公開を動かす
prefix_rule(pattern=["git", "push"], decision="forbidden")
prefix_rule(pattern=["git", "commit"], decision="forbidden")
prefix_rule(pattern=["git", "reset"], decision="forbidden")
prefix_rule(pattern=["git", "checkout"], decision="forbidden")
prefix_rule(pattern=["git", "switch"], decision="forbidden")
prefix_rule(pattern=["git", "clean"], decision="forbidden")
prefix_rule(pattern=["git", "rebase"], decision="forbidden")
prefix_rule(pattern=["git", "merge"], decision="forbidden")
prefix_rule(pattern=["git", "submodule"], decision="forbidden")
prefix_rule(pattern=["gh"], decision="forbidden")

# 外へ出る。通信は組み込みのWeb検索1つに絞る。
# 検索は経路が記録に残り、返した本文にURLが付く。シェルからの取得は残らない。
prefix_rule(pattern=["curl"], decision="forbidden")
prefix_rule(pattern=["wget"], decision="forbidden")
prefix_rule(pattern=["nc"], decision="forbidden")
prefix_rule(pattern=["ncat"], decision="forbidden")
prefix_rule(pattern=["ssh"], decision="forbidden")
prefix_rule(pattern=["scp"], decision="forbidden")
prefix_rule(pattern=["rsync"], decision="forbidden")

# 入れる。ホストには何も入れない方針である。
prefix_rule(pattern=["sudo"], decision="forbidden")
prefix_rule(pattern=["su"], decision="forbidden")
prefix_rule(pattern=["apt"], decision="forbidden")
prefix_rule(pattern=["apt-get"], decision="forbidden")
prefix_rule(pattern=["pip"], decision="forbidden")
prefix_rule(pattern=["pip3"], decision="forbidden")
prefix_rule(pattern=["pipx"], decision="forbidden")
prefix_rule(pattern=["uv"], decision="forbidden")
prefix_rule(pattern=["npm"], decision="forbidden")
prefix_rule(pattern=["npx"], decision="forbidden")
prefix_rule(pattern=["cargo"], decision="forbidden")

# サンドボックスの外へ出る
prefix_rule(pattern=["docker"], decision="forbidden")
prefix_rule(pattern=["podman"], decision="forbidden")

# 書き換える形の sed
prefix_rule(pattern=["sed", "-i"], decision="forbidden")

# --- 先に許すもの -------------------------------------------------------
#
# 調査で繰り返し使う。approval_policy を厳しくしたときに止まらないよう、
# ここで先に許しておく。

prefix_rule(pattern=["git", "status"], decision="allow")
prefix_rule(pattern=["git", "log"], decision="allow")
prefix_rule(pattern=["git", "diff"], decision="allow")
prefix_rule(pattern=["git", "show"], decision="allow")
prefix_rule(pattern=["git", "ls-files"], decision="allow")

prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["grep"], decision="allow")
prefix_rule(pattern=["cat"], decision="allow")
prefix_rule(pattern=["head"], decision="allow")
prefix_rule(pattern=["tail"], decision="allow")
prefix_rule(pattern=["ls"], decision="allow")
prefix_rule(pattern=["find"], decision="allow")
prefix_rule(pattern=["wc"], decision="allow")
prefix_rule(pattern=["sort"], decision="allow")
prefix_rule(pattern=["uniq"], decision="allow")
prefix_rule(pattern=["cut"], decision="allow")
prefix_rule(pattern=["nl"], decision="allow")
prefix_rule(pattern=["awk"], decision="allow")
prefix_rule(pattern=["sed", "-n"], decision="allow")

# --- 発信元 -------------------------------------------------------------
#
# 根拠に使ってよい発信元を挙げる。一覧の理由は
# .agents/rules/repository-constraints.md にある。
#
# **この環境では、network_rule による遮断を確認できていない。**
# codex 0.149.1 を Linux で動かし、許可していないホストへの取得を試したところ、
# 組み込みのWeb検索でもシェルの curl でも通った。network_rule は
# 「管理された串（proxy）」を使う構成でのみ効くと codex のログが示している。
# **この環境で実際に効いているのは、上の curl と wget の禁止である。**
# それでも書いておくのは、規格上の指定であり、串を使う構成では効くためである。

network_rule(host="www.iso.org", protocol="https", decision="allow")
network_rule(host="google.github.io", protocol="https", decision="allow")
network_rule(host="martinfowler.com", protocol="https", decision="allow")
network_rule(host="www.ipa.go.jp", protocol="https", decision="allow")
network_rule(host="jstqb.jp", protocol="https", decision="allow")
network_rule(host="www.istqb.org", protocol="https", decision="allow")
network_rule(host="www.jtf.jp", protocol="https", decision="allow")
network_rule(host="semver.org", protocol="https", decision="allow")
network_rule(host="www.w3.org", protocol="https", decision="allow")
network_rule(host="datatracker.ietf.org", protocol="https", decision="allow")
