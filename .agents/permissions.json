{
  "_この設定について": [
    "このリポジトリで Antigravity（agy）を動かすときの許可リストである。",
    "tools/agy.sh がこれを読み、リポジトリ専用の設定ファイルを組み立てて agy を起動する。",
    "個人のグローバル設定 ~/.gemini/antigravity-cli/settings.json は書き換えない。",
    "使える道具名は read_file / write_file / command / read_url の4つである。",
    "それ以外の名前を書いても agy は黙って捨てる。動作は変わらない。",
    "allow に無い道具は、ヘッドレス実行では自動で拒否される。"
  ],
  "permissions": {
    "allow": [
      "read_file(*)",
      "command(*)",

      "read_url(https://www.iso.org/*)",
      "read_url(https://google.github.io/*)",
      "read_url(https://martinfowler.com/*)",
      "read_url(https://www.ipa.go.jp/*)",
      "read_url(https://jstqb.jp/*)",
      "read_url(https://www.jstqb.jp/*)",
      "read_url(https://www.istqb.org/*)",
      "read_url(https://www.jtf.jp/*)",
      "read_url(https://semver.org/*)",
      "read_url(https://www.w3.org/*)",
      "read_url(https://datatracker.ietf.org/*)",
      "read_url(https://smartbear.com/*)",
      "read_url(https://static0.smartbear.co/*)",
      "read_url(https://ht-0328.github.io/*)"
    ],
    "deny": [
      "write_file(*)",

      "command(git)",
      "command(gh)",
      "command(docker)",
      "command(podman)",
      "command(rm)",
      "command(mv)",
      "command(chmod)",
      "command(chown)",
      "command(curl)",
      "command(wget)",
      "command(ssh)",
      "command(scp)",
      "command(rsync)",
      "command(sudo)",
      "command(apt)",
      "command(apt-get)",
      "command(pip)",
      "command(pip3)",
      "command(npm)",
      "command(npx)",
      "command(cargo)"
    ]
  }
}
